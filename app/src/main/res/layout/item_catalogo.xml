<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/imgCatalogo"
        android:layout_width="96dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_foto"
        android:contentDescription="Foto del producto"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCatNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inria_serif_bold"
            android:textColor="@color/text_brown"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvCatPrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/bree_serif"
            android:textColor="@color/gold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCatTallas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inria_serif_regular"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>