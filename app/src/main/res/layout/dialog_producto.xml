<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/imgFotoProducto"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="@drawable/bg_foto"
            android:contentDescription="Foto del producto"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCamara"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_gold"
                android:backgroundTint="@null"
                android:fontFamily="@font/bree_serif"
                android:stateListAnimator="@null"
                android:text="Cámara"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnGaleria"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_gray"
                android:backgroundTint="@null"
                android:fontFamily="@font/bree_serif"
                android:stateListAnimator="@null"
                android:text="Galería"
                android:textAllCaps="false"
                android:textColor="@color/text_dark" />
        </LinearLayout>

        <EditText
            android:id="@+id/etProdNombre"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:fontFamily="@font/inria_serif_regular"
            android:hint="Nombre del producto"
            android:inputType="textCapSentences"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etProdPrecio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:fontFamily="@font/inria_serif_regular"
            android:hint="Precio en COP (ej: 120000)"
            android:inputType="number"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etProdTallas"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:fontFamily="@font/inria_serif_regular"
            android:hint="Tallas (ej: XS, S, M, L)"
            android:inputType="textCapCharacters"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etProdColores"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:fontFamily="@font/inria_serif_regular"
            android:hint="Colores (ej: Blanco, Negro, Vino)"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etProdDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:fontFamily="@font/inria_serif_regular"
            android:gravity="top"
            android:hint="Descripción"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="80dp"
            android:padding="14dp"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spProdEstado"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input" />
    </LinearLayout>
</ScrollView>