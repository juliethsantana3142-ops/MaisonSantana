<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/btnVolverCarrito"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:text="←"
                android:textColor="@color/gold"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inria_serif_bold"
                android:text="Carrito de compras"
                android:textColor="@color/gold"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/contenedorCarrito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvTotalCarrito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inria_serif_bold"
                android:textColor="@color/gold"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnIrPagar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_gold"
                android:backgroundTint="@null"
                android:fontFamily="@font/bree_serif"
                android:stateListAnimator="@null"
                android:text="Ir a pagar"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnVaciar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_gray"
                android:backgroundTint="@null"
                android:fontFamily="@font/bree_serif"
                android:stateListAnimator="@null"
                android:text="Vaciar carrito"
                android:textAllCaps="false"
                android:textColor="@color/text_muted" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>