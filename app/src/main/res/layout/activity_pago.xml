<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/btnVolver"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:text="←"
                android:textColor="@color/gold"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inria_serif_bold"
                android:text="Dirección de Envío:"
                android:textColor="@color/gold"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etDireccion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:autofillHints="postalAddress"
                android:background="@drawable/bg_input"
                android:fontFamily="@font/inria_serif_regular"
                android:hint="Tu dirección de envío"
                android:inputType="textPostalAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/inria_serif_bold"
                android:text="Método de Pago:"
                android:textColor="@color/gold"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rgPago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:fontFamily="@font/inria_serif_regular"
                    android:text="Tarjeta de Crédito / Débito" />

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:fontFamily="@font/inria_serif_regular"
                    android:text="PSE (Transferencia Bancaria)" />

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:fontFamily="@font/inria_serif_regular"
                    android:text="Nequi / Daviplata" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/inria_serif_bold"
                android:text="Resumen del Pedido:"
                android:textColor="@color/gold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inria_serif_regular"
                android:textColor="@color/text_brown" />

            <TextView
                android:id="@+id/tvEnvio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inria_serif_regular"
                android:textColor="@color/text_brown" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inria_serif_bold"
                android:textColor="@color/gold"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnProcesar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_button_gold"
                android:backgroundTint="@null"
                android:fontFamily="@font/bree_serif"
                android:stateListAnimator="@null"
                android:text="PROCESAR PAGO SEGURO"
                android:textColor="@color/white" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bar_gray"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♡"
            android:textColor="@color/text_dark"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🔍"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/navCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🛒"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👤"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>