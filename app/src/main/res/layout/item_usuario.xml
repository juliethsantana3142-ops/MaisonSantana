<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvUsuarioNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/inria_serif_bold"
        android:textColor="@color/text_brown"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvUsuarioCorreo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inria_serif_regular"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inria_serif_regular"
            android:text="Rol:"
            android:textColor="@color/text_brown" />

        <Spinner
            android:id="@+id/spRolUsuario"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inria_serif_regular"
            android:text="Estado:"
            android:textColor="@color/text_brown" />

        <Spinner
            android:id="@+id/spEstadoUsuario"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnModificar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_gold"
            android:backgroundTint="@null"
            android:fontFamily="@font/bree_serif"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:stateListAnimator="@null"
            android:text="Modificar permisos"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnEliminar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_button_gray"
            android:backgroundTint="@null"
            android:fontFamily="@font/bree_serif"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:stateListAnimator="@null"
            android:text="Eliminar"
            android:textAllCaps="false"
            android:textColor="@color/text_dark" />
    </LinearLayout>
</LinearLayout>