<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/great_vibes"
            android:gravity="center"
            android:text="Maison"
            android:textColor="@color/gold"
            android:textSize="40sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inria_serif_regular"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:text="SANTANA"
            android:textColor="@color/gold"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inria_serif_bold"
            android:gravity="center"
            android:text="PANEL ADMINISTRATIVO"
            android:textColor="@color/gold"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inria_serif_regular"
            android:gravity="center"
            android:text="Gestión De Usuarios Y Permisos"
            android:textColor="@color/text_muted" />

        <Button
            android:id="@+id/btnNuevoUsuario"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill_gold"
            android:backgroundTint="@null"
            android:fontFamily="@font/bree_serif"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:stateListAnimator="@null"
            android:text="+ Nuevo usuario"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <LinearLayout
            android:id="@+id/contenedorUsuarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnSalirAdmin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button_gray"
            android:backgroundTint="@null"
            android:fontFamily="@font/bree_serif"
            android:stateListAnimator="@null"
            android:text="Cerrar sesión"
            android:textAllCaps="false"
            android:textColor="@color/text_dark" />
    </LinearLayout>
</ScrollView>