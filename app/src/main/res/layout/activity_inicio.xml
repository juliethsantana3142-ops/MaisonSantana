<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/great_vibes"
                android:gravity="center"
                android:paddingTop="36dp"
                android:text="Maison"
                android:textColor="@color/gold"
                android:textSize="40sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inria_serif_regular"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:paddingBottom="16dp"
                android:text="SANTANA"
                android:textColor="@color/gold"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/gold"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:fontFamily="@font/bree_serif"
                    android:gravity="center"
                    android:text="Blusas"
                    android:textColor="@color/gold"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:fontFamily="@font/bree_serif"
                    android:gravity="center"
                    android:text="Pantalones"
                    android:textColor="@color/gold"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:fontFamily="@font/bree_serif"
                    android:gravity="center"
                    android:text="Vestidos"
                    android:textColor="@color/gold"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:fontFamily="@font/bree_serif"
                    android:gravity="center"
                    android:text="Conjuntos"
                    android:textColor="@color/gold"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/inria_serif_bold"
                android:text="PROMO DESTACADA"
                android:textColor="@color/gold"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_margin="16dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgPromo1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_foto"
                    android:scaleType="centerCrop"
                    android:src="@drawable/promo_1" />

                <ImageView
                    android:id="@+id/imgPromo2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_foto"
                    android:scaleType="centerCrop"
                    android:src="@drawable/promo2" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:fontFamily="@font/great_vibes"
                android:text="Colección Primavera"
                android:textColor="@color/gold"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:fontFamily="@font/inria_serif_regular"
                android:text="/ VERANO 2026"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnNuevaColeccion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="20dp"
                android:background="@drawable/bg_pill_gold"
                android:backgroundTint="@null"
                android:fontFamily="@font/bree_serif"
                android:stateListAnimator="@null"
                android:text="Ver nueva colección"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:fontFamily="@font/inria_serif_bold"
                android:text="Productos Destacados:"
                android:textColor="@color/gold"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/card1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgProd1"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:background="@drawable/bg_foto"
                        android:scaleType="centerCrop"
                        android:src="@drawable/body_perlas" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/inria_serif_regular"
                        android:text="Body Satinado de Tirantes con Perlas"
                        android:textColor="@color/text_brown"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inria_serif_bold"
                        android:text="$48.000 COP"
                        android:textColor="@color/gold"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgProd2"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:background="@drawable/bg_foto"
                        android:scaleType="centerCrop"
                        android:src="@drawable/vestido_vino" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/inria_serif_regular"
                        android:text="Vestido Corto Strapless Vino"
                        android:textColor="@color/text_brown"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inria_serif_bold"
                        android:text="$180.000 COP"
                        android:textColor="@color/gold"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgProd3"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:background="@drawable/bg_foto"
                        android:scaleType="centerCrop"
                        android:src="@drawable/vestido_negro" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/inria_serif_regular"
                        android:text="Vestido Negro Asimétrico"
                        android:textColor="@color/text_brown"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inria_serif_bold"
                        android:text="$220.000 COP"
                        android:textColor="@color/gold"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bar_gray"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♡"
            android:textColor="@color/text_dark"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🔍"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/navCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🛒"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👤"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>