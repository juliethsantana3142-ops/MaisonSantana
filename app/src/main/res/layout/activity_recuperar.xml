<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingEnd="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="60dp"
            android:fontFamily="@font/great_vibes"
            android:text="Maison"
            android:textColor="@color/gold"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-6dp"
            android:fontFamily="@font/inria_serif_regular"
            android:letterSpacing="0.1"
            android:text="SANTANA"
            android:textColor="@color/gold"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/inria_serif_bold"
            android:text="Recuperar contraseña"
            android:textColor="@color/gold"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp"
            android:fontFamily="@font/inria_serif_regular"
            android:gravity="center"
            android:text="Escribe tu correo y tu nueva contraseña"
            android:textColor="@color/text_slogan"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/inria_serif_regular"
            android:letterSpacing="0.15"
            android:text="@string/label_email"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etRecCorreo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/bg_input"
            android:fontFamily="@font/inria_serif_regular"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/inria_serif_regular"
            android:letterSpacing="0.15"
            android:text="NUEVA CONTRASEÑA"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etRecNueva"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:autofillHints="newPassword"
            android:background="@drawable/bg_input"
            android:fontFamily="@font/inria_serif_regular"
            android:hint="Mínimo 6 caracteres"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRestablecer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button_gold"
            android:backgroundTint="@null"
            android:fontFamily="@font/bree_serif"
            android:stateListAnimator="@null"
            android:text="Restablecer contraseña"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnVolverRec"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_gray"
            android:backgroundTint="@null"
            android:fontFamily="@font/bree_serif"
            android:stateListAnimator="@null"
            android:text="Volver al login"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="30dp" />

    </LinearLayout>
</ScrollView>