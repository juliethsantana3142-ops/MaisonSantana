<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inria_serif_bold"
                android:text="Gestión De Productos"
                android:textColor="@color/gold"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnNuevo"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill_gold"
                android:backgroundTint="@null"
                android:fontFamily="@font/bree_serif"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:stateListAnimator="@null"
                android:text="+ Nuevo"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/inria_serif_bold"
                android:text="Vestido Seda Gala"
                android:textColor="@color/text_brown" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inria_serif_regular"
                android:text="Tallas: XS (3), M (5), L (0)\nPrecio: $180.000 COP | Estado: Activo"
                android:textColor="@color/text_brown"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEditar1"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_pill_gold"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/bree_serif"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:stateListAnimator="@null"
                    android:text="Editar"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btnFoto1"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pill_gold"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/bree_serif"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:stateListAnimator="@null"
                    android:text="Tomar Foto"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/inria_serif_bold"
                android:text="Chaqueta Cuero Sintético"
                android:textColor="@color/text_brown" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inria_serif_regular"
                android:text="Tallas: XS (1), M (10), L (3)\nPrecio: $220.000 COP | Estado: Activo"
                android:textColor="@color/text_brown"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEditar2"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_pill_gold"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/bree_serif"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:stateListAnimator="@null"
                    android:text="Editar"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btnFoto2"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pill_gold"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/bree_serif"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:stateListAnimator="@null"
                    android:text="Tomar Foto"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgFalda"
                    android:layout_width="90dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_foto"
                    android:scaleType="centerCrop"
                    android:src="@drawable/falda_cuero" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/inria_serif_regular"
                    android:text="Falda Corta Efecto Cuero Maison Ivory\nTallas: XS (20), M (10), L (5)\nPrecio: $48.000 COP\nEstado: Activo"
                    android:textColor="@color/text_brown"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bar_gray"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👤"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/navInventario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📦"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/navReportes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📊"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/navPedidos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🚚"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/navBuscar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🔍"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>